<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" prefWidth="800" prefHeight="600" xmlns="http://javafx.com/javafx/17.0.12" 
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.parqueadero.controller.OperarioController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="INTERFAZ DE OPERARIO" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="30">
        <!-- SECCION INGRESO -->
        <VBox spacing="10" prefWidth="350" style="-fx-border-color: lightgray; -fx-padding: 10;">
            <Label text="REGISTRAR INGRESO" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbTipoVehiculo" promptText="Tipo de Vehiculo" />
            <TextField fx:id="txtPlacaIngreso" promptText="Placa" />
            <TextField fx:id="txtNombreConductor" promptText="Nombre Conductor" />
            <TextField fx:id="txtIdConductor" promptText="ID Conductor" />
            <TextField fx:id="txtHoraIngreso" promptText="Hora Ingreso (militar)" />
            <TextField fx:id="txtMarcaBici" promptText="Atributo distinguido" />
            <TextField fx:id="txtEspacio" promptText="Espacio Asignado" />
            <Button text="Registrar Entrada" onAction="#registrarIngreso" maxWidth="Infinity" style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
        </VBox>

        <!-- SECCION SALIDA Y LISTA -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <VBox spacing="10" style="-fx-border-color: lightgray; -fx-padding: 10;">
                <Label text="REGISTRAR SALIDA" style="-fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <TextField fx:id="txtPlacaSalida" promptText="Placa vehiculo" HBox.hgrow="ALWAYS"/>
                    <Button text="Registrar Salida" onAction="#registrarSalida" style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
            
            <Label text="VEHÍCULOS ACTUALMENTE DENTRO:" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="txtAreaVehiculos" VBox.vgrow="ALWAYS" editable="false" />
            <Button text="Refrescar Lista" onAction="#actualizarLista" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <Button text="Cerrar Sesión" onAction="#cerrarSesion" style="-fx-background-color: #6c757d; -fx-text-fill: white;"/>
</VBox>