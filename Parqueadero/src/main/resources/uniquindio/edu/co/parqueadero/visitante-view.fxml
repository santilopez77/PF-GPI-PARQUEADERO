<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.parqueadero.controller.VisitanteController">

    <children>

        <Label layoutX="180" layoutY="30" text="CONSULTA" />

        <Button layoutX="150"
                layoutY="120"
                text="Ver Espacios Disponibles"
                onAction="#verEspacios"/>

        <Button layoutX="180"
                layoutY="190"
                text="Ver Tarifas"
                onAction="#verTarifas"/>

        <TextArea fx:id="txtAreaInvitado"
                  layoutX="70"
                  layoutY="260"
                  prefHeight="90"
                  prefWidth="340"/>

    </children>
</AnchorPane>