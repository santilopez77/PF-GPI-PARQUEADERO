<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="474.0" prefWidth="466.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.parqueadero.Controller.HelloController"> <!-- Controlador corregido -->
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" text="Parqueadero"> <!-- Texto de bienvenida -->
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>
    <Label text="Haz clic para ingresar">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <Button contentDisplay="BOTTOM" onAction="#onIngresarClick" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="INGRESAR" /> <!-- Nuevo método y estilo -->
</VBox>
